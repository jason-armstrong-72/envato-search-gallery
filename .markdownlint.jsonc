{
  // Jason's standard markdown lint rules — project file wins over editor-level
  // config, so VSCode squiggles and CI (`npm run lint:md`) always agree.
  // Source of truth: ~/.claude/templates/markdownlint/ — keep in sync with the
  // `markdownlint.config` block in VSCode user settings.json.
  "default": true,
  "MD004": { "style": "dash" }, // unordered lists use `-` — NOT "consistent" (which leaves each brownfield file with whatever its first bullet was, so + / * / - drift across files)
  "MD013": false, // line length — too noisy for prose
  "MD024": { "siblings_only": true }, // repeated headings OK across sections (changelogs)
  "MD033": false, // inline HTML allowed (<details>, <br>)
  "MD049": { "style": "asterisk" }, // emphasis uses `*` — NOT "consistent" (which is order-dependent: adding a `*` above an existing `_` retroactively fails unrelated lines). Same reasoning as MD004.
  "MD060": { "style": "compact" } // tables use single-space pipe padding
}
