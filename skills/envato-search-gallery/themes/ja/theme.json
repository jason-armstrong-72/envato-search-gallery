{
  "schema_version": 4,
  "name": "jason-armstrong",
  "display_name": "JA",
  "version": "3.0.0",
  "owner": "Jason Armstrong",
  "derived_from": "Started from measurements of https://www.archetypeai.io/ (off-white page, near-black ink, light headings, small uppercase mono labels, near-square corners), then changed: Forest green accent, a derived dark theme, house coral kept for error and warning only.",
  "fonts": {
    "body": {
      "family": "Hanken Grotesk",
      "weights": [
        200,
        300,
        400,
        500
      ],
      "fallback": "\"Helvetica Neue\", Arial, sans-serif",
      "css_url": "https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@200..500&display=swap",
      "install_url": "https://fonts.google.com/specimen/Hanken+Grotesk",
      "office_fallback": "Arial",
      "licence": "SIL OFL"
    },
    "mono": {
      "family": "IBM Plex Mono",
      "weights": [
        200,
        300,
        400,
        500
      ],
      "fallback": "ui-monospace, Menlo, Consolas, monospace",
      "css_url": "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@200;300;400;500&display=swap",
      "install_url": "https://fonts.google.com/specimen/IBM+Plex+Mono",
      "office_fallback": "Consolas",
      "licence": "SIL OFL"
    }
  },
  "type": {
    "display": {
      "family": "heading",
      "case": "none",
      "size_px": 64,
      "weight": 300,
      "tracking_em": -0.035,
      "line_height": 1.02,
      "usage": "Page title"
    },
    "h2": {
      "family": "heading",
      "case": "none",
      "size_px": 36,
      "weight": 200,
      "tracking_em": -0.03,
      "line_height": 1.08,
      "usage": "Heading 2"
    },
    "h3": {
      "family": "heading",
      "case": "none",
      "size_px": 22,
      "weight": 200,
      "tracking_em": -0.02,
      "line_height": 1.2,
      "usage": "Heading 3"
    },
    "lead": {
      "family": "body",
      "case": "none",
      "size_px": 18,
      "weight": 200,
      "tracking_em": -0.01,
      "line_height": 1.45,
      "usage": "Lead paragraph"
    },
    "title": {
      "family": "body",
      "case": "none",
      "size_px": 15,
      "weight": 200,
      "tracking_em": -0.01,
      "line_height": 1.35,
      "usage": "Card title"
    },
    "body": {
      "family": "body",
      "case": "none",
      "size_px": 15,
      "weight": 200,
      "tracking_em": 0,
      "line_height": 1.5,
      "usage": "Body copy"
    },
    "caption": {
      "family": "body",
      "case": "none",
      "size_px": 13,
      "weight": 200,
      "tracking_em": 0,
      "line_height": 1.4,
      "usage": "Caption"
    },
    "eyebrow": {
      "family": "mono",
      "case": "upper",
      "size_px": 11,
      "weight": 400,
      "tracking_em": 0.04,
      "line_height": 1.2,
      "usage": "Small label above the title"
    },
    "label": {
      "family": "mono",
      "case": "upper",
      "size_px": 11,
      "weight": 300,
      "tracking_em": 0.04,
      "line_height": 1.4,
      "usage": "Filter heading, chip, note, footer"
    },
    "button": {
      "family": "mono",
      "case": "upper",
      "size_px": 12,
      "weight": 400,
      "tracking_em": 0.04,
      "line_height": 1.2,
      "usage": "Buttons, links and the theme toggle"
    },
    "code": {
      "family": "mono",
      "case": "none",
      "size_px": 13,
      "weight": 300,
      "tracking_em": 0,
      "line_height": 1.5,
      "usage": "Code"
    },
    "data": {
      "family": "body",
      "case": "none",
      "size_px": 15,
      "weight": 300,
      "tracking_em": 0,
      "line_height": 1.5,
      "usage": "Text in inputs, selects, table cells and toasts"
    },
    "panel-title": {
      "family": "body",
      "case": "none",
      "size_px": 15,
      "weight": 500,
      "tracking_em": -0.01,
      "line_height": 1.3,
      "usage": "Panel section title"
    },
    "panel-label": {
      "family": "body",
      "case": "none",
      "size_px": 13,
      "weight": 400,
      "tracking_em": 0,
      "line_height": 1.35,
      "usage": "Panel row label"
    },
    "panel-note": {
      "family": "body",
      "case": "none",
      "size_px": 12,
      "weight": 300,
      "tracking_em": 0,
      "line_height": 1.4,
      "usage": "Panel note"
    }
  },
  "colour": {
    "bg": {
      "light": "#f1f1f0",
      "dark": "#000000",
      "usage": "Page background"
    },
    "surface": {
      "light": "#fbfbfa",
      "dark": "#111111",
      "usage": "Cards and panel"
    },
    "border": {
      "light": "#e0e0e0",
      "dark": "#2a2a2a",
      "usage": "Hairline border"
    },
    "ink": {
      "light": "#1a1a1a",
      "dark": "#f1f1f0",
      "usage": "Main text"
    },
    "muted": {
      "light": "#606060",
      "dark": "#a0a0a0",
      "usage": "Muted text"
    },
    "accent": {
      "light": "#0d8a4b",
      "dark": "#34d399",
      "usage": "Accent for shapes, bars and borders (Forest green)"
    },
    "accent-text": {
      "light": "#066f33",
      "dark": "#34d399",
      "usage": "Accent for small text (deeper in light: 5.6:1 on the page, 5.1:1 on the hover tint, 4.6:1 on the pressed tint)"
    },
    "error": {
      "light": "#f4503b",
      "dark": "#ff5c48",
      "usage": "Error shapes and bars"
    },
    "warning": {
      "light": "#b45309",
      "dark": "#fbbf24",
      "usage": "Warning and caution: shapes and bars (deep amber, so it stands apart from the coral error)"
    },
    "btn-bg": {
      "light": "#1a1a1a",
      "dark": "#f1f1f0",
      "usage": "Button fill"
    },
    "btn-ink": {
      "light": "#ffffff",
      "dark": "#000000",
      "usage": "Button text"
    },
    "focus": {
      "light": "#1a1a1a",
      "dark": "#34d399",
      "usage": "Keyboard focus ring, 2px, 2px offset"
    }
  },
  "tint_percent": {
    "light": 8,
    "dark": 16
  },
  "spacing_scale": {
    "steps_px": [
      4,
      8,
      12,
      16,
      20,
      24,
      32,
      40,
      48,
      56,
      64
    ],
    "off_scale": [
      "maxw",
      "rcard",
      "rchip",
      "rbtn"
    ]
  },
  "spacing_and_shape": {
    "pagex": {
      "px": 20,
      "usage": "Page side padding"
    },
    "pagetop": {
      "px": 32,
      "usage": "Space above header"
    },
    "pagebot": {
      "px": 40,
      "usage": "Page bottom padding"
    },
    "maxw": {
      "px": 1400,
      "usage": "Content max width"
    },
    "gaptight": {
      "px": 8,
      "usage": "Space between closely related things: ds-row, and ds-stack with is-tight."
    },
    "gap": {
      "px": 16,
      "usage": "Space between things in a group: ds-stack."
    },
    "gaploose": {
      "px": 32,
      "usage": "Space between loosely related things: ds-stack with is-loose."
    },
    "gapsection": {
      "px": 64,
      "usage": "Space between page sections, and above headings in long text."
    },
    "cardpad": {
      "px": 20,
      "usage": "Padding inside cards, modals, callouts and stat tiles"
    },
    "chipx": {
      "px": 8,
      "usage": "Chip padding, sides"
    },
    "chipy": {
      "px": 4,
      "usage": "Chip padding, top and bottom"
    },
    "btnx": {
      "px": 12,
      "usage": "Button padding, sides"
    },
    "btny": {
      "px": 8,
      "usage": "Button padding, top and bottom"
    },
    "rcard": {
      "px": 1,
      "usage": "Card and panel radius"
    },
    "rchip": {
      "px": 1,
      "usage": "Chip radius"
    },
    "rbtn": {
      "px": 1,
      "usage": "Button radius"
    }
  },
  "measure_ch": 68,
  "motion": {
    "duration_s": 0.14,
    "easing": "ease"
  },
  "touch_targets": {
    "min_px": 24,
    "coarse_px": 44
  },
  "small_screen": {
    "max_width_px": 600,
    "grow_below_px": 20,
    "grow_by_px": 2,
    "cap_px": 48,
    "roles": {}
  },
  "status": {
    "style": "dot",
    "tones": {
      "positive": "accent",
      "neutral": "muted",
      "caution": "warning",
      "critical": "error",
      "info": "muted"
    }
  },
  "chart": {
    "categorical": [
      {
        "light": "#0d8a4b",
        "dark": "#34d399"
      },
      {
        "light": "#2563eb",
        "dark": "#60a5fa"
      },
      {
        "light": "#7c3aed",
        "dark": "#a78bfa"
      },
      {
        "light": "#0e7490",
        "dark": "#22d3ee"
      },
      {
        "light": "#a16207",
        "dark": "#facc15"
      },
      {
        "light": "#be185d",
        "dark": "#f472b6"
      }
    ],
    "sequential_steps": 5
  },
  "brand": {
    "logo": "assets/mark.svg",
    "logo_dark": "assets/mark-dark.svg",
    "alt": "Jason Armstrong",
    "height_px": 28,
    "placement": "above",
    "invert_in_dark": false,
    "placeholder": true
  },
  "states": {
    "colour_is_a_shape": "Colour marks a state with a shape (a square, a bar, an edge, an underline). The words stay in ink. Never set small text in the accent, error or warning colour.",
    "chips": "A chip is static unless it carries is-action. Only interactive chips take hover, pressed and selected states.",
    "theme_switch": "Every page offers Light, Dark and System, starts on System, and remembers the choice."
  },
  "components": {
    "no_text_on_error": "Never put text on the error colour. An error toast keeps its message in the button-text colour beside the error square.",
    "tables": "Wrap every table in ds-table-wrap so it scrolls sideways on a phone instead of the page.",
    "navigation": "Navigation links may carry a numbered prefix (_01, _02) in muted.",
    "not_covered": [
      "combobox",
      "breadcrumb",
      "file upload"
    ]
  },
  "voice": {
    "summary": "Short, plain and to the point. Explain it the way a patient teacher would, in one line, then stop.",
    "rules": [
      "Get to the point in the first sentence.",
      "Keep sentences short. One idea each.",
      "Explain the why in one plain line when it helps, then stop.",
      "Use plain words. If a tool has its own label for something, put the label in quotes.",
      "State facts without hedging. Say 'needs', not 'may need', when the need is real.",
      "Report finished work in the past tense: 'Saved', not 'Saving your changes'.",
      "Say what an action gives the reader, not what happens if they skip it.",
      "Use contractions.",
      "End on the next step, not on reassurance."
    ],
    "spelling": "Australian",
    "capitalisation": "sentence case",
    "avoid": [
      "em dashes and en dashes",
      "emoji",
      "filler openers such as 'Welcome to' or 'Here you can'",
      "intensifiers: just, simply, actually, really",
      "jargon the reader has to look up",
      "exclamation marks",
      "title case headings"
    ],
    "examples": [
      {
        "instead_of": "Oops! Something went wrong while attempting to process your request.",
        "write": "That didn't save. Try again."
      },
      {
        "instead_of": "Simply leverage the filter functionality to refine your results",
        "write": "Filter the results."
      },
      {
        "instead_of": "You may need to grant access before continuing",
        "write": "Grant access to continue."
      },
      {
        "instead_of": "No Results Found",
        "write": "Nothing matched. Try a broader search."
      }
    ]
  },
  "scope": {
    "default": true,
    "names": [
      "JA",
      "Jason Armstrong",
      "my brand",
      "my design system"
    ],
    "not_when": [
      "Brandunity, Vaultia or any other brand or client is named",
      "the work is inside a repo or project that has its own design system or brand",
      "a skill with its own built-in look is running and this brand is not named"
    ],
    "outputs": {
      "html": {
        "applies": "default",
        "how": "recipes/html.md"
      },
      "artifact": {
        "applies": "default",
        "how": "recipes/html.md"
      },
      "word": {
        "applies": "default",
        "how": "recipes/office.md"
      },
      "powerpoint": {
        "applies": "default",
        "how": "recipes/office.md"
      },
      "image": {
        "applies": "when_named",
        "how": "recipes/images.md"
      }
    }
  }
}
